; FRONTLINE: CONFLICT — Godot 4.5.2 / GLES3 mobile FPS.
config_version=5

[application]
config/name="FRONTLINE CONFLICT"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/description="Offline first-person tactical campaign prototype"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.12, 0.17, 0.20, 1.0)

[input_devices]

pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[physics]
3d/default_gravity=19.0

[debug]
settings/stdout/print_fps=false
